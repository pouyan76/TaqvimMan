
package ir.taqvimm.an

import android.content.Context
import android.media.AudioAttributes
import android.media.MediaPlayer

class OnlineAdhanPlayer(context: Context) {

    private val appContext = context.applicationContext
    private var player: MediaPlayer? = null

    private val adhanUrl =
        "https://dl.namaz.ir/s/c/other/azan/rahim_moazenzadeh.mp3"

    fun play(
        onStatus: (String) -> Unit
    ) {
        stop()

        try {
            onStatus("در حال دریافت اذان...")

            val media = MediaPlayer()
            player = media

            media.setAudioAttributes(
                AudioAttributes.Builder()
                    .setUsage(AudioAttributes.USAGE_MEDIA)
                    .setContentType(
                        AudioAttributes.CONTENT_TYPE_MUSIC
                    )
                    .build()
            )

            media.setDataSource(adhanUrl)

            media.setOnPreparedListener {
                if (player === it) {
                    it.start()
                    onStatus("اذان در حال پخش است")
                }
            }

            media.setOnCompletionListener {
                if (player === it) {
                    it.release()
                    player = null
                    onStatus("پخش اذان تمام شد")
                }
            }

            media.setOnErrorListener { mp, _, _ ->
                if (player === mp) {
                    mp.release()
                    player = null
                }

                onStatus("خطا در پخش اذان؛ اینترنت را بررسی کنید")
                true
            }

            media.prepareAsync()

        } catch (e: Exception) {
            stop()
            onStatus("خطا در اتصال به فایل صوتی")
        }
    }

    fun stop() {
        val oldPlayer = player
        player = null

        try {
            oldPlayer?.let {
                if (it.isPlaying) {
                    it.stop()
                }
                it.release()
            }
        } catch (_: Exception) {
        }
    }

    fun release() {
        stop()
    }
}
